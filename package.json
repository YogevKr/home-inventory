{
  "name": "home-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run assets && cf dev --mode development",
    "build": "npm run assets && cf build",
    "check": "tsc --noEmit",
    "rates:update": "node scripts/update-price-rates.mjs",
    "test": "node scripts/test.mjs",
    "test:running": "node --test --test-concurrency=1 tests/*.test.mjs",
    "deploy": "cf deploy",
    "assets": "esbuild src/export.js --bundle --format=esm --minify --outfile=public/export.bundle.js",
    "build:local": "npm run assets && cf build --mode development",
    "db:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000002 --local --mode development --dir migrations"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jose": "^6.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/node": "^24.10.0",
    "cf": "1.0.0-beta.32",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.10.0"
  }
}
